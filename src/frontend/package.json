{
  "name": "fiap-store-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run start:produtos\" \"npm run start:carrinho\" \"npm run start:checkout\" \"npm run start:host\" \"npm run start:notificacoes\"",
    "start:host": "ng serve host --port 4200 --open",
    "start:produtos": "ng serve mfe-produtos --port 4201",
    "start:carrinho": "ng serve mfe-carrinho --port 4202",
    "start:checkout": "ng serve mfe-checkout --port 4203",
    "start:notificacoes": "ng serve mfe-notificacoes --port 4204",
    "build": "ng build",
    "build:shared": "ng build shared",
    "build:all": "ng build host && ng build mfe-produtos && ng build mfe-carrinho && ng build mfe-checkout && ng build mfe-notificacoes",
    "check:shared": "node scripts/check-shared.mjs",
    "manifest:local": "node scripts/use-manifest.mjs local",
    "manifest:dev": "node scripts/use-manifest.mjs dev",
    "manifest:solo": "node scripts/use-manifest.mjs solo",
    "prestart": "npm run manifest:local",
    "start:local": "npm start",
    "start:dev": "npm run manifest:dev && npm run start:host",
    "start:solo": "npm run manifest:solo && concurrently \"npm run start:host\" \"ng serve $npm_config_mfe --port $npm_config_port\"",
    "preview": "http-server dist -p 4300 --cors -c-1 --silent"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular-architects/native-federation": "^21.2.6",
    "@angular/animations": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.25",
    "@softarc/native-federation-node": "^3.3.4",
    "cors": "^2.8.5",
    "es-module-shims": "^1.5.12",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.25",
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^10.0.6",
    "http-server": "^14.1.1",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
